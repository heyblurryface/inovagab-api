# Copie para .env (docker compose le automaticamente) ou exporte no terminal / IDE
MONGODB_URI=mongodb://localhost:27017/inovagab
JWT_SECRET=inovagab-fiap-2026-chave-secreta-de-desenvolvimento-troque-em-prod
JWT_EXPIRACAO_HORAS=12
GEMINI_API_KEY=
# Aceita lista separada por virgula: a cota gratuita e por modelo, entao o segundo
# entra quando o primeiro esgota a cota do dia.
GEMINI_MODEL=gemini-3.6-flash
IA_FALLBACK_HEURISTICA=true
SEED_ENABLED=true
PORT=8080
